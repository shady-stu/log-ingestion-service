{
  "name": "log-ingestion-service",
  "version": "1.0.0",
  "description": "High-performance log ingestion and query service",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn src/index.ts",
    "start": "node dist/src/index.js",
    "load:test": "node scripts/load-test.js",
    "seed:query": "node scripts/seed-query-dataset.js",
    "benchmark:query": "node scripts/query-benchmark.js",
    "benchmark:aggregate": "node scripts/aggregate-benchmark.js",
    "benchmark:mixed": "node scripts/mixed-read-benchmark.js",
    "benchmark:coordinator": "node scripts/coordinator-acceptance-benchmark.js",
    "test:contract": "node scripts/contract-smoke-test.js",
    "lint": "eslint src/**/*.ts",
    "test": "jest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.2",
    "pg": "^8.12.0",
    "pg-copy-streams": "^7.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.11.6",
    "@types/pg-copy-streams": "^1.2.5",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
